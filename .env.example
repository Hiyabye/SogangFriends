# Registration script process environment only; never commit populated files.
DISCORD_APPLICATION_ID=YOUR_NEW_APPLICATION_ID
DISCORD_TOKEN=YOUR_NEW_BOT_TOKEN
# Worker local secrets: copy these to .dev.vars (gitignored).
OPENROUTER_API_KEY=YOUR_LIMITED_CREDIT_API_KEY
# Shared Worker secret and GitHub Actions secret for the standalone notice collector.
NOTICE_INGEST_SECRET=GENERATE_A_DEDICATED_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# GitHub Actions/local collector only; NOT a Worker secret.
NOTICE_INGEST_URL=https://YOUR_WORKER.workers.dev/internal/notices
# Optional Node/Actions raw capture; requires separately approved D1 migrations 0003/0004 and Worker activation.
NOTICE_ARCHIVE_ENABLED=false
# Worker non-secret configuration belongs in wrangler.toml [vars].
